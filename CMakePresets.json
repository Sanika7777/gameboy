{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "web-base",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    { "name": "native-debug",   "inherits": "base",     "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "native-release", "inherits": "base",     "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    { "name": "web-debug",      "inherits": "web-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "web-release",    "inherits": "web-base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } }
  ],
  "buildPresets": [
    { "name": "native-debug",   "configurePreset": "native-debug" },
    { "name": "native-release", "configurePreset": "native-release" },
    { "name": "web-debug",      "configurePreset": "web-debug" },
    { "name": "web-release",    "configurePreset": "web-release" }
  ],
  "testPresets": [
    { "name": "native-debug",   "configurePreset": "native-debug",   "output": { "outputOnFailure": true } },
    { "name": "native-release", "configurePreset": "native-release", "output": { "outputOnFailure": true } }
  ]
}
